<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!--
    Package visibility, by name and only by name. Android 11 and later hide the installed apps
    from an app that has not said which ones it cares about, and «Сповіщення банків» offers only
    the bank apps this phone actually has: an app the phone does not have can never post a
    сповіщення, and offering it is offering a watch that will stay silent forever.

    Every package here is one already hard-coded in `KNOWN_BANK_APPS`
    (`src/ui/notification-settings.ts`), and a Node-only test in
    `src/platform/notification-capture.test.ts` fails the day the two lists drift.

    Never `QUERY_ALL_PACKAGES`: it is a Play-restricted permission, it asks for the whole phone,
    and this app has no case for either. A named list gives visibility of exactly the packages the
    app already knows about and of nothing else.
  -->
  <queries>
    <package android:name="ua.privatbank.ap24" />
    <package android:name="ua.oschadbank.flumo" />
    <package android:name="ua.oschadbank.online" />
    <package android:name="com.fuib.android.spot.online" />
    <package android:name="ua.raiffeisen.myraif" />
    <package android:name="ua.aval.dbo.client.android" />
    <package android:name="com.ukrsibbank.uso.android" />
    <package android:name="com.ukrsibbank.client.android" />
    <package android:name="ua.alfabank.mobile.android" />
    <package android:name="ua.com.abank" />
    <package android:name="ua.otpbank.android" />
    <package android:name="ua.creditagricole.mobile.app" />
    <package android:name="com.ugb.app" />
    <package android:name="com.eximb.enter" />
    <package android:name="ua.izibank.app" />
    <package android:name="com.tas.tas2u" />
    <package android:name="ua.android.kredobank.prod" />
    <package android:name="com.bank.pivdenny" />
    <package android:name="com.vostok.bv" />
    <package android:name="com.creditdnepr.mb" />
    <package android:name="com.t18.bone.personal.globus" />
    <package android:name="ua.ideabank.obank" />
    <package android:name="ua.monvel.bankalliance" />
    <package android:name="bank.sky.app" />
    <package android:name="com.ua.mtb.bank" />
    <package android:name="online.kapowai.accordbank" />
  </queries>
  <application>
    <!--
      The listener Android binds to when the owner switches the app on at «Доступ до сповіщень».
      `BIND_NOTIFICATION_LISTENER_SERVICE` is the system's own guard on that binding — held by the
      OS, never asked of the user — and declaring it is what makes the app appear on that screen
      at all, which is the permission FR-S3's reading of other banks' push notifications rests on.
      Exported because the system binds it from outside the app; the guard is what keeps everyone
      else out.
    -->
    <service
      android:name="expo.modules.notificationcapture.CaptureListenerService"
      android:exported="true"
      android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
      <intent-filter>
        <action android:name="android.service.notification.NotificationListenerService" />
      </intent-filter>
    </service>
  </application>
</manifest>
