# dependencies / build
node_modules/
.expo/
dist/
web-build/
coverage/
*.tsbuildinfo
expo-env.d.ts
.metro-health-check*
*.orig.*
.kotlin/

# generated native folders (CNG: `expo prebuild` recreates them; never hand-edited)
/android
/ios
local.properties
# a local Expo module's own Gradle output — the module's source is committed, its build is not
modules/*/android/build/
modules/*/android/.gradle/

# secrets — also denied to the agent in .claude/settings.json
.env
.env.*
!.env.example
*.jks
*.keystore
*.p12
*.p8
*.key
*.pem
*.mobileprovision
google-services.json
GoogleService-Info.plist
secrets/

# personal data — never commit exports of real finances
saldo_export*.csv
data/private/

# the DOCX build of docs/app-overview.md — 3 MB of binary that duplicates the Markdown.
# Rebuild it with `node scripts/build-overview-docx.mjs`; the Markdown is the source.
docs/*.docx

# verify stamp and hook state
.cache/

# Claude Code local files
.claude/settings.local.json
CLAUDE.local.md

# OS / editor
.DS_Store
*.log
npm-debug.log*
